# Solana RPC. Devnet is the default for local development.
# Do not point this at a private RPC that contains secrets unless you know why.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# HTTP API
API_HOST=127.0.0.1
API_PORT=3001

# Persistence is not used in Phase 1. Leave empty.
# When we add storage, SQLite (file:) first, PostgreSQL later.
DATABASE_URL=
