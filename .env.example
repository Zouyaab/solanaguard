# Solana RPC. Devnet is the default for local development.
# Do not point this at a private RPC that contains secrets unless you know why.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# HTTP API
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Phase 16 hardening
RPC_TIMEOUT_MS=20000
API_BODY_LIMIT_BYTES=16384
API_REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Dashboard (apps/web) — copy into apps/web/.env.local if needed
NEXT_PUBLIC_SOLANAGUARD_API_URL=http://127.0.0.1:3001

# Wallet demo (examples/wallet-demo) — copy into examples/wallet-demo/.env if needed
# VITE_SOLANAGUARD_API_URL=http://127.0.0.1:3001
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Opt-in live Devnet tests (never required for default CI)
# SOLANAGUARD_DEVNET_IT=1

# Micro-benchmarks (pnpm bench)
SOLANAGUARD_BENCH_WARMUP=5
SOLANAGUARD_BENCH_ITERATIONS=40

# Persistence is not used yet. Leave empty.
# When we add storage, SQLite (file:) first, PostgreSQL later.
DATABASE_URL=
