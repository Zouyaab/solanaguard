# Solana RPC. Devnet is the default for local development.
# Do not point this at a private RPC that contains secrets unless you know why.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# HTTP API
API_HOST=127.0.0.1
API_PORT=3001

# Phase 16 hardening
RPC_TIMEOUT_MS=20000
API_BODY_LIMIT_BYTES=16384
API_REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Dashboard (apps/web) — copy into apps/web/.env.local if needed
# NEXT_PUBLIC_SOLANAGUARD_API_URL=http://127.0.0.1:3001

# Persistence is not used yet. Leave empty.
# When we add storage, SQLite (file:) first, PostgreSQL later.
DATABASE_URL=
